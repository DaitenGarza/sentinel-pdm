# test fixtures) are not ignored by accident. reports/ and docs/ ARE committed.
/data/
/artifacts/

# Logs and secrets (.streamlit/config.toml, the dashboard theme, IS committed)
*.log
logs/
.env
.streamlit/secrets.toml

